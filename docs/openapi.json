  },
  "components": {
    "schemas": {
      "CaptureCreate": {
        "properties": {
          "protocol_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Protocol Id"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Patient Id"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Session Id"
          },
          "image_base64": {
            "type": "string",
            "maxLength": 9000000,
            "minLength": 1,
            "title": "Image Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "protocol_id",
          "patient_id",
          "session_id",
          "image_base64"
        ],
        "title": "CaptureCreate"
      },
      "CaptureOut": {
        "properties": {
          "capture_id": {
            "type": "string",
            "title": "Capture Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "needs_confirmation",
              "unreadable",
              "rejected"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Why the frame was dropped: no_display | invalid_output | ai_timeout | ai_error | gateway_rejected"
          },
          "bounding_box": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bounding Box",
            "description": "[ymin, xmin, ymax, xmax], 0-1000"
          },
          "image_width": {
            "type": "integer",
            "title": "Image Width"
          },
          "image_height": {
            "type": "integer",
            "title": "Image Height"
          },
          "readings": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Readings"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Flags",
            "default": []
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Errors",
            "default": []
          },
          "voice_line_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Line Id",
            "description": "Set when voice_script is a fixed line"
          },
          "voice_script": {
            "type": "string",
            "title": "Voice Script"
          },
          "audio_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Url",
            "description": "Streams ElevenLabs audio for voice_script"
          },
          "ai_latency_ms": {
            "type": "number",
            "title": "Ai Latency Ms"
          },
          "validation_ns": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validation Ns"
          }
        },
        "type": "object",
        "required": [
          "capture_id",
          "status",
          "image_width",
          "image_height",
          "voice_script",
          "ai_latency_ms"
        ],
        "title": "CaptureOut"
      },
      "ConfirmRequest": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotency_key"
        ],
        "title": "ConfirmRequest"
      },
      "CrossFieldRule": {
        "properties": {
          "type": {
            "type": "string",
            "const": "greater_than",
            "title": "Type",
            "default": "greater_than"
          },
          "left": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "title": "Left"
          },
          "right": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "title": "Right"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "left",
          "right"
        ],
        "title": "CrossFieldRule"
      },
      "EventOut": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "protocol_id": {
            "type": "string",
            "title": "Protocol Id"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "capture_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture Id"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "flagged"
            ],
            "title": "Status"
          },
          "extracted_data": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Extracted Data"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Flags"
          },
          "validation_ns": {
            "type": "integer",
            "title": "Validation Ns"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "protocol_id",
          "patient_id",
          "session_id",
          "capture_id",
          "idempotency_key",
          "status",
          "extracted_data",
          "flags",
          "validation_ns",
          "timestamp"
        ],
        "title": "EventOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "ai_mode": {
            "type": "string",
            "enum": [
              "gemini",
              "mock"
            ],
            "title": "Ai Mode"
          },
          "voice_enabled": {
            "type": "boolean",
            "title": "Voice Enabled"
          },
          "gemini_model": {
            "type": "string",
            "title": "Gemini Model"
          },
          "active_protocol_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Protocol Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "ai_mode",
          "voice_enabled",
          "gemini_model",
          "active_protocol_id"
        ],
        "title": "HealthOut"
      },
      "IngestRequest": {
        "properties": {
          "protocol_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Protocol Id"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Patient Id"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Session Id"
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "title": "Idempotency Key"
          },
          "readings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Readings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "protocol_id",
          "patient_id",
          "session_id",
          "idempotency_key",
          "readings"
        ],
        "title": "IngestRequest",
        "description": "Direct gateway submission. ``readings`` is deliberately untyped: the gateway,\nnot the HTTP layer, decides whether values are acceptable (and logs rejections)."
      },
      "IngestResponse": {
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "accepted",
              "flagged"
            ],
            "title": "Result"
          },
          "event": {
            "$ref": "#/components/schemas/EventOut"
          },
          "validation_ns": {
            "type": "integer",
            "title": "Validation Ns"
          },
          "voice_line_id": {
            "type": "string",
            "enum": [
              "saved",
              "saved_flagged"
            ],
            "title": "Voice Line Id"
          },
          "voice_script": {
            "type": "string",
            "title": "Voice Script"
          }
        },
        "type": "object",
        "required": [
          "result",
          "event",
          "validation_ns",
          "voice_line_id",
          "voice_script"
        ],
        "title": "IngestResponse"
      },
      "Issue": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "metric": {
