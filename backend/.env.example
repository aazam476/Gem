# Copy to backend/.env (gitignored). Keys live ONLY here, never in the mobile app.

# --- Gemini (vision) ---------------------------------------------------------
GEMINI_API_KEY=
# Confirm the current Flash ID at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# minimal | low | medium | high  (lower = faster)
GEMINI_THINKING_LEVEL=low

# Model for the Gem camera assistant (frames + voice -> answer + annotations).
GEMINI_ASSISTANT_MODEL=gemini-3.8-flash

# --- ElevenLabs (voice) ------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Modes & budgets ---------------------------------------------------------
# 1 = offline demo: deterministic fake Gemini, on-device speech instead of ElevenLabs.
GEM_MOCK_AI=0
# Values the mock "reads". Set {"systolic": 900, "diastolic": 82} to demo a hallucination being blocked.
GEM_MOCK_READINGS={"systolic": 128, "diastolic": 82, "pulse": 71}
GEM_AI_TIMEOUT_S=8
GEM_CAPTURE_TTL_S=600
GEM_ASSISTANT_TIMEOUT_S=20
# Purge an assistant session (its frames, history and cached audio) after this many
# seconds with neither a frame nor a prompt.
GEM_SESSION_IDLE_TIMEOUT_S=600
# Visual memory: frames kept for this long (only when the scene changes, plus one every
# keepalive period) and ALL sent with each question so Gem can point at things it saw earlier.
GEM_MEMORY_S=300
GEM_SESSION_MAX_FRAMES=300
GEM_FRAME_DEDUPE_THRESHOLD=0.02
GEM_FRAME_KEEPALIVE_S=30
# Newest frames sent at high resolution (1120 tokens); older ones at low (280 tokens).
GEM_HIGH_RES_RECENT_FRAMES=2

# --- Server ------------------------------------------------------------------
GEM_DATABASE_PATH=gem.db
# Web portal origin(s). Expo web dev server defaults to 8081.
GEM_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Where researcher study documents (PDFs, images) are stored. Gitignored.
GEM_UPLOADS_DIR=uploads
# Optional shared secret required on direct POST /ingest_vitals calls.
GEM_GATEWAY_TOKEN=
